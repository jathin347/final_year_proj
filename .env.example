# VeritasAI Environment Configuration
# Copy this file to .env and provide your API keys where available.
# When API keys are omitted, the application operates in resilient fallback mode (local heuristic analysis & mock/offline indicators).

# AI & LLM Provider (Optional - for enhanced reasoning & claim extraction)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Live Fact-Checking Provider (Optional - for Google Fact Check Tools API)
# Get a key from: https://developers.google.com/fact-check/tools/api
GOOGLE_FACT_CHECK_API_KEY=

# Database configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./fake_news.db

# Server and CORS settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Application Security
MAX_CONTENT_LENGTH_MB=10
REQUEST_TIMEOUT_SECONDS=15
ENABLE_SSRF_PROTECTION=True
